preferred-citation:
  type: article
  title: >
    The Pain Diary and Shadow Discipline: A Memory System That Learns
    from Its Own Incidents
  authors:
    - family-names: Busnello
      given-names: Luiz Antonio
      alias: Toto
      email: lab@generantis.com.br
      # orcid: "https://orcid.org/0000-0000-0000-0000"  # VERIFY: fill if ORCID is obtained
  year: 2026
  # VERIFY: update arxiv-id and url after submission on 2026-06-02
  # Format expected post-submit: arxiv-id: "arXiv:2606.NNNNN"
  #                              url: "https://arxiv.org/abs/2606.NNNNN"
  journal: "arXiv preprint"
  arxiv-id: "TBD-arXiv:2606.NNNNN"
  url: "TBD-https://arxiv.org/abs/2606.NNNNN"
  abstract: >
    We present NOX-Supermem, a production memory system for multi-agent AI
    fleets that treats operational discipline — not retrieval sophistication —
    as the primary design constraint. The system introduces pain-weighted
    salience (severity as a retrieval signal), shadow discipline (enforced
    ranking validation gates), and shared-canonical multi-agent context.
    Evaluated on 61,257 chunks over approximately three months of production operation.
