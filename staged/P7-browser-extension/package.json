{
  "name": "memoria-nox-extension",
  "version": "0.1.0",
  "description": "memoria-nox browser extension — Phase 1 MVP (manifest v3 + A1 in JS + popup + omnibox)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --package",
    "test": "node --test extension/__tests__/**/*.test.mjs",
    "test:patterns": "node --test extension/src/lib/privacy/__tests__/*.test.mjs",
    "lint:manifest": "node scripts/lint-manifest.mjs",
    "clean": "rm -rf dist/"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/totobusnello/memoria-nox.git",
    "directory": "staged/P7-browser-extension"
  }
}
